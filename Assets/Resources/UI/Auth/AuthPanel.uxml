<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" editor-extension-mode="False">
    <!-- AuthPanel.uss is attached at runtime by AuthPanelController via Resources.Load. -->

    <!-- Root. The controller toggles .signed-out / .signed-in on this element. -->
    <ui:VisualElement name="auth-root" class="auth-root signed-out" picking-mode="Position">

        <!-- ==================== SIGNED-OUT VIEW ==================== -->
        <ui:VisualElement name="signed-out-view" class="auth-card signed-out-only">

            <ui:Label name="title" text="JadedBelles" class="auth-title" />
            <ui:Label name="subtitle" text="Sign in to sync your progress" class="auth-subtitle" />

            <!-- Tab strip -->
            <ui:VisualElement name="tab-bar" class="tab-bar">
                <ui:Button name="tab-login"    text="Log in"   class="tab-btn tab-btn--active" />
                <ui:Button name="tab-register" text="Register" class="tab-btn" />
            </ui:VisualElement>

            <!-- ---------- Login panel ---------- -->
            <ui:VisualElement name="panel-login" class="tab-panel tab-panel--active">
                <ui:TextField name="login-email"    label="Email"    class="auth-field" />
                <ui:TextField name="login-password" label="Password" password="true" mask-character="•" class="auth-field" />
                <ui:Button    name="btn-login"      text="Log in"    class="auth-primary" />
            </ui:VisualElement>

            <!-- ---------- Register panel ---------- -->
            <ui:VisualElement name="panel-register" class="tab-panel">
                <ui:TextField name="reg-display"  label="Display name" class="auth-field" />
                <ui:TextField name="reg-email"    label="Email"        class="auth-field" />
                <ui:TextField name="reg-password" label="Password" password="true" mask-character="•" class="auth-field" />
                <ui:Button    name="btn-register" text="Create account" class="auth-primary" />
            </ui:VisualElement>

            <!-- Status / error line -->
            <ui:Label name="status" text="" class="auth-status" />

            <!-- Guest / footer -->
            <ui:VisualElement class="auth-footer">
                <ui:Button name="btn-guest" text="Play as guest" class="auth-secondary" />
            </ui:VisualElement>

            <!-- Busy overlay -->
            <ui:VisualElement name="busy-overlay" class="busy-overlay hidden" picking-mode="Position">
                <ui:Label text="Working..." class="busy-label" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ==================== SIGNED-IN VIEW ==================== -->
        <ui:VisualElement name="signed-in-view" class="auth-card signed-in-only">
            <ui:Label name="welcome" text="Welcome back" class="auth-title" />
            <ui:Label name="user-display" text="" class="auth-user-display" />
            <ui:Label name="user-email"   text="" class="auth-user-email" />
            <ui:Button name="btn-logout"  text="Log out" class="auth-secondary" />

            <!-- Danger zone: Google Play requires an in-app way to request
                 account deletion whenever the app lets users create an
                 account. Two-step confirmation (button → confirm button)
                 so a stray tap can't fire the deletion request. -->
            <ui:VisualElement name="danger-zone" class="auth-danger-zone">
                <ui:Label text="Danger zone" class="auth-danger-label" />
                <ui:Button name="btn-delete-account" text="Delete my account" class="auth-danger" />
                <ui:VisualElement name="delete-confirm" class="auth-danger-confirm hidden">
                    <ui:Label text="This will email a confirmation link to your account address. You'll click that link to actually schedule deletion. Personal data is removed immediately after confirmation; the row is permanently purged 30 days later." class="auth-danger-copy" />
                    <ui:VisualElement class="auth-danger-row">
                        <ui:Button name="btn-delete-confirm" text="Send confirmation email" class="auth-danger" />
                        <ui:Button name="btn-delete-cancel"  text="Cancel" class="auth-secondary" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
