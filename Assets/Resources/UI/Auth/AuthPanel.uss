/* =========================================================
   AuthPanel.uss  —  reusable auth panel styling.
   Uses only UI Toolkit-supported USS.
   ========================================================= */

.auth-root {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    background-color: rgba(0, 0, 0, 0.55);
    padding: 24px;
}

/* View toggles driven by .signed-out / .signed-in on .auth-root */
.auth-root.signed-out .signed-in-only  { display: none; }
.auth-root.signed-in  .signed-out-only { display: none; }

.auth-card {
    width: 380px;
    max-width: 92%;
    padding: 24px 24px 20px 24px;
    background-color: rgb(24, 26, 33);
    border-radius: 14px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.auth-title {
    font-size: 22px;
    color: rgb(240, 240, 245);
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 2px;
}

.auth-subtitle {
    font-size: 12px;
    color: rgba(220, 220, 230, 0.7);
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

/* ---- Tabs ---- */
.tab-bar {
    flex-direction: row;
    margin-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.tab-btn {
    flex-grow: 1;
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    color: rgba(220, 220, 230, 0.55);
    padding: 8px 4px;
    font-size: 13px;
    -unity-font-style: bold;
}

.tab-btn:hover {
    color: rgb(240, 240, 245);
}

.tab-btn--active {
    color: rgb(240, 240, 245);
    border-bottom-width: 2px;
    border-bottom-color: rgb(120, 170, 255);
}

.tab-panel { display: none; }
.tab-panel--active { display: flex; }

/* ---- Fields ---- */
.auth-field {
    margin-bottom: 10px;
}

.auth-field > .unity-base-field__label {
    color: rgba(220, 220, 230, 0.75);
    font-size: 11px;
    min-width: 90px;
}

.auth-field > .unity-base-text-field__input {
    background-color: rgb(34, 37, 46);
    border-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-radius: 8px;
    padding: 8px 10px;
    color: rgb(240, 240, 245);
    font-size: 13px;
}

.auth-field > .unity-base-text-field__input:focus {
    border-color: rgb(120, 170, 255);
}

/* ---- Buttons ---- */
.auth-primary {
    margin-top: 6px;
    padding: 10px 12px;
    background-color: rgb(120, 170, 255);
    color: rgb(15, 18, 24);
    border-width: 0;
    border-radius: 8px;
    font-size: 13px;
    -unity-font-style: bold;
}

.auth-primary:hover { background-color: rgb(150, 190, 255); }
.auth-primary:active { background-color: rgb(100, 150, 230); }
.auth-primary:disabled { opacity: 0.55; }

.auth-secondary {
    margin-top: 8px;
    padding: 8px 12px;
    background-color: rgba(255, 255, 255, 0.06);
    color: rgb(220, 220, 230);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.10);
    border-radius: 8px;
    font-size: 12px;
}

.auth-secondary:hover { background-color: rgba(255, 255, 255, 0.10); }

/* ---- Status line ---- */
.auth-status {
    min-height: 16px;
    margin-top: 8px;
    font-size: 11px;
    color: rgb(255, 130, 130);
    white-space: normal;
    -unity-text-align: middle-center;
}

.auth-status--ok { color: rgb(140, 220, 160); }

/* ---- Footer ---- */
.auth-footer {
    margin-top: 10px;
    align-items: stretch;
}

/* ---- Signed-in view ---- */
.auth-user-display {
    font-size: 16px;
    color: rgb(240, 240, 245);
    -unity-text-align: middle-center;
    margin-top: 4px;
}

.auth-user-email {
    font-size: 11px;
    color: rgba(220, 220, 230, 0.7);
    -unity-text-align: middle-center;
    margin-bottom: 14px;
}

/* ---- Busy overlay ---- */
.busy-overlay {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgba(0, 0, 0, 0.55);
    justify-content: center;
    align-items: center;
    border-radius: 14px;
}

.busy-label {
    color: rgb(240, 240, 245);
    font-size: 13px;
    -unity-font-style: bold;
}

.hidden { display: none; }

/* ---- Danger zone (account deletion) ---- */
/* Sits at the bottom of the signed-in view. Muted-red styling so users
   don't misread it as a normal action, plus a top rule to visually
   separate it from the log-out button above. */
.auth-danger-zone {
    margin-top: 18px;
    padding-top: 14px;
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.10);
}

.auth-danger-label {
    color: rgb(240, 130, 130);
    font-size: 11px;
    -unity-font-style: bold;
    margin-bottom: 6px;
    letter-spacing: 1px;
}

.auth-danger {
    background-color: rgb(120, 40, 50);
    color: rgb(250, 235, 235);
    border-width: 0;
    border-radius: 8px;
    padding: 8px 12px;
    font-size: 13px;
    -unity-font-style: bold;
    margin-top: 4px;
}

.auth-danger:hover { background-color: rgb(150, 55, 65); }
.auth-danger:active { background-color: rgb(95, 30, 40); }
.auth-danger:disabled { opacity: 0.55; }

.auth-danger-confirm {
    margin-top: 10px;
    padding: 10px 12px;
    background-color: rgba(120, 40, 50, 0.18);
    border-radius: 8px;
}

.auth-danger-copy {
    color: rgb(230, 210, 210);
    font-size: 11px;
    white-space: normal;
    margin-bottom: 8px;
}

.auth-danger-row {
    flex-direction: row;
    justify-content: space-between;
}

.auth-danger-row > .auth-danger,
.auth-danger-row > .auth-secondary {
    flex-grow: 1;
    margin-top: 0;
    margin-right: 4px;
}

.auth-danger-row > .auth-secondary { margin-right: 0; margin-left: 4px; }
